{
  "$defs": {
    "Check": {
      "additionalProperties": false,
      "properties": {
        "check_id": {
          "title": "Check Id",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/CheckStatus"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        }
      },
      "required": [
        "check_id",
        "status",
        "reason"
      ],
      "title": "Check",
      "type": "object"
    },
    "CheckStatus": {
      "enum": [
        "SATISFIED",
        "VIOLATED",
        "UNRESOLVED",
        "NOT_APPLICABLE"
      ],
      "title": "CheckStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "r3-r4/0.1",
      "default": "r3-r4/0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "episode_id": {
      "title": "Episode Id",
      "type": "string"
    },
    "call_id": {
      "title": "Call Id",
      "type": "string"
    },
    "proposal_hash": {
      "title": "Proposal Hash",
      "type": "string"
    },
    "status": {
      "enum": [
        "ok",
        "unavailable",
        "error"
      ],
      "title": "Status",
      "type": "string"
    },
    "checks": {
      "items": {
        "$ref": "#/$defs/Check"
      },
      "title": "Checks",
      "type": "array"
    },
    "error": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error"
    }
  },
  "required": [
    "episode_id",
    "call_id",
    "proposal_hash",
    "status"
  ],
  "title": "AssessmentResponse",
  "type": "object"
}
